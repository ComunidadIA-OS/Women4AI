# Copia a .env (no se versiona). Nunca pongas secretos en configs/ ni en el código.

# Hugging Face: necesario para pyannote/speaker-diarization-3.1 (aceptar condiciones en HF).
HF_TOKEN=

# Mozilla Data Collective (descarga de Common Voice para scripts/train_gender.py).
MDC_API_KEY=

# LLM vía API OpenAI-compatible. Tienen prioridad sobre YAML. Ver docs/llm.md.
#   vLLM propio en la V100S:  http://localhost:8000/v1   (LLM_API_KEY puede quedar vacío)
#   OVH AI Endpoints:         https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=BSC-LT/salamandra-7b-instruct-2606
